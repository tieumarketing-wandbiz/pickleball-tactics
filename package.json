{
  "name": "pickleball-tactics-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node tests/browser.mjs",
    "test:contact": "node tests/contact-browser.mjs",
    "test:volley": "node tests/volley-browser.mjs",
    "rig:build": "vite-node tools/rig/finalize.ts --from-source",
    "rig:validate": "vite-node tools/rig/validate.ts public/models/male-rigged.glb"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.0",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
